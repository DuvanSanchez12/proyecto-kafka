BRAND=Nike
KAFKA_TOPIC=menciones
KAFKA_BROKERS=kafka:9092
# Direccion de Kafka vista desde el HOST (para consola o clientes externos).
# En Windows con Docker Desktop tambien funciona localhost:9094.
KAFKA_BROKER_HOST=localhost:9094

POSTGRES_USER=marketing
POSTGRES_PASSWORD=marketing
POSTGRES_DB=brandpulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Ritmo independiente de cada productor (mensajes por segundo)
PRODUCER_X_RATE=12
PRODUCER_REDDIT_RATE=12
# Cada cuanto Spark cierra un micro-lote (segundos)
SPARK_TRIGGER=10
# Filas por lote SQL que cada particion de Spark inserta en PostgreSQL
DB_BATCH_SIZE=500

API_PORT=8000
WEB_PORT=5173

# Neo4j (grafo de co-ocurrencia)
NEO4J_AUTH=neo4j/brandpulse123
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=brandpulse123
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
