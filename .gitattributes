# Normaliza los finales de linea: en Windows el checkout no debe convertir a
# CRLF los archivos que se montan dentro de contenedores Linux.
* text=auto eol=lf

*.sh    text eol=lf
Dockerfile text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.conf  text eol=lf
*.env   text eol=lf

# Binarios que no deben tocarse
*.png   binary
*.jpg   binary
*.jar   binary